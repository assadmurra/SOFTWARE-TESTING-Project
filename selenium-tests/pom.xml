<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.swer312</groupId>
  <artifactId>visualizer-tests</artifactId>
  <version>1.0</version>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <browser>chrome</browser>
    <headless>true</headless>
    <baseUrl>http://localhost:8000</baseUrl>
    <parallel>false</parallel>
    <threads>3</threads>
    <!-- Cucumber tag expression; scenarios documenting open application bugs are excluded by default -->
    <tags>not @known-bug</tags>
    <!-- Allure reporting: raw results are written here during the test run -->
    <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>4.38.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>7.30.0</version>
      <scope>test</scope>
    </dependency>
    <!-- Shares one ScenarioContext between all step classes of a scenario (dependency injection) -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <version>7.30.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>7.30.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>1.14.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.14.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.14.1</version>
      <scope>test</scope>
    </dependency>
    <!-- Reads the Excel (.xlsx) test-data workbook -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.1</version>
      <scope>test</scope>
    </dependency>
    <!-- Allure report: Cucumber plugin that records every scenario, step and attachment -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-cucumber7-jvm</artifactId>
      <version>3.1.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <!-- Start every run with an empty Allure results folder, so old results never mix in -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>clean-allure-results</id>
            <phase>initialize</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${allure.results.directory}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Allure report generation: "mvn allure:report" builds target/allure-report/index.html as ONE
        self-contained file (opens with a double-click), "mvn allure:serve" opens the interactive
        report. Maven downloads the Allure command-line tool itself; nothing has to be installed.
      -->
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>3.1.0</version>
        <configuration>
          <reportVersion>2.46.2</reportVersion>
          <!-- Outside the project folder: keeps the tool out of git, and away from special characters
               (such as "&") in the project path, which break Allure's Windows launcher -->
          <installDirectory>${user.home}/.allure</installDirectory>
          <resultsDirectory>${allure.results.directory}</resultsDirectory>
          <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
          <singleFile>true</singleFile>
        </configuration>
      </plugin>
      <!--
        Data-driven testing: after the test classes are compiled, turn every row of
        src/test/resources/data/*.csv and *.xlsx into a Cucumber scenario.
        New rows therefore run without editing any .feature file.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>generate-data-driven-features</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>edu.swer312.data.DataFeatureGenerator</mainClass>
              <classpathScope>test</classpathScope>
              <systemProperties>
                <!-- POI logs through Log4j; use Log4j's built-in simple logger instead of an error banner -->
                <systemProperty>
                  <key>log4j2.loggerContextFactory</key>
                  <value>org.apache.logging.log4j.simple.SimpleLoggerContextFactory</value>
                </systemProperty>
              </systemProperties>
              <arguments>
                <argument>${project.basedir}/src/test/resources/data</argument>
                <argument>${project.basedir}/src/test/resources/graphs</argument>
                <argument>${project.basedir}/src/test/resources/templates/data-driven.feature.template</argument>
                <argument>${project.build.testOutputDirectory}/features/generated</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <systemPropertyVariables>
            <browser>${browser}</browser>
            <headless>${headless}</headless>
            <baseUrl>${baseUrl}</baseUrl>
            <cucumber.filter.tags>${tags}</cucumber.filter.tags>
            <allure.results.directory>${allure.results.directory}</allure.results.directory>
            <cucumber.execution.parallel.enabled>${parallel}</cucumber.execution.parallel.enabled>
            <cucumber.execution.parallel.config.strategy>fixed</cucumber.execution.parallel.config.strategy>
            <cucumber.execution.parallel.config.fixed.parallelism>${threads}</cucumber.execution.parallel.config.fixed.parallelism>
            <cucumber.execution.parallel.config.fixed.max-pool-size>${threads}</cucumber.execution.parallel.config.fixed.max-pool-size>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
